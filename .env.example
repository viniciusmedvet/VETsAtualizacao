PORT=3000

# URL pública do servidor (Railway, Render, ou IP local)
BASE_URL=https://seuapp.railway.app

# Google OAuth — obtenha em console.cloud.google.com
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-seu-client-secret

# Chave secreta para assinar os cookies de sessão (qualquer string aleatória longa)
SESSION_SECRET=mude-para-uma-string-aleatoria-longa-aqui
